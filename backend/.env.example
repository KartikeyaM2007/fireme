# Copy to backend/.env before starting the API.
# AI provider configuration. Groq is OpenAI-compatible and supports transcription and chat.
AI_PROVIDER=groq
DATABASE_URL=postgresql+psycopg://postgres:replace-with-url-encoded-password@db.your-project.supabase.co:5432/postgres?sslmode=require
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
GROQ_API_KEY=
GROQ_SUMMARY_MODEL=llama-3.3-70b-versatile
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
# Alternative provider for transcription, AI summaries, action extraction, and Ask FireMe.
OPENAI_API_KEY=
# Cost/quality controls; change only if your OpenAI account supports another model.
OPENAI_SUMMARY_MODEL=gpt-5-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe-diarize
# Comma-separated frontend origins in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Local storage is used by default. Mount this directory as persistent storage when deployed.
UPLOAD_DIR=./uploads
